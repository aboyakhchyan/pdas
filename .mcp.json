{
    "mcpServers": {
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp"
            ]
        },
        "playwright": {
            "command": "npx",
            "args": [
                "-y",
                "@playwright/mcp@latest"
            ]
        },
        "postgres": {
            "command": "npx",
            "args": [
                "-y",
                "@bytebase/dbhub",
                "--dsn",
                "${DATABASE_URL:-postgresql://pdas:pdas@localhost:5432/pdas}"
            ]
        },
        "chrome-devtools": {
            "command": "npx",
            "args": [
                "-y",
                "chrome-devtools-mcp@latest"
            ]
        }
    }
}
