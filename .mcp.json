{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"]
    },
    "postgres": {
      "command": "npx",
      "args": [
        "-y",
        "@bytebase/dbhub",
        "--dsn",
        "${DATABASE_URL:-postgresql://hyework:hyework@localhost:5432/hyework}"
      ]
    },
    "dart": {
      "command": "dart",
      "args": ["mcp-server"]
    }
  }
}
