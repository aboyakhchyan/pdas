{
  "name": "hyework",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev --filter=!@hyework/mobile",
    "dev:web": "turbo run dev --filter=@hyework/web...",
    "dev:admin": "turbo run dev --filter=@hyework/admin...",
    "dev:api": "turbo run dev --filter=@hyework/api...",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test --filter=!@hyework/mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:up": "docker compose -f infrastructure/compose/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infrastructure/compose/docker-compose.dev.yml down",
    "docker:up": "docker compose -f infrastructure/compose/docker-compose.local.yml up -d --build",
    "docker:down": "docker compose -f infrastructure/compose/docker-compose.local.yml down",
    "docker:logs": "docker compose -f infrastructure/compose/docker-compose.local.yml logs -f",
    "gen:api": "bash scripts/generate-api-client.sh",
    "clean": "turbo run clean && rm -rf node_modules .turbo"
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "catalog:"
  }
}
