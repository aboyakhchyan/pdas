{
    "extends": "@pdas/typescript-config/nestjs.json",
    "compilerOptions": {
        "outDir": "./dist",
        "rootDir": ".",
        "paths": {
            "@common/*": ["./src/common/*"],
            "@config/*": ["./src/config/*"],
            "@infra/*": ["./src/infra/*"],
            "@modules/*": ["./src/modules/*"],
            "@testing/*": ["./src/testing/*"]
        },
        "types": ["node", "jest", "multer"]
    },
    "include": ["src", "test"]
}
