NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

REDIS_URL=redis://localhost:6379

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=pdas-dev-key

# Console levels; LOG_PERSIST_LEVELS go to Firestore `logs` (empty = off), kept LOG_RETENTION_DAYS
LOG_LEVELS=fatal,error,warn,log,debug
LOG_PERSIST_LEVELS=fatal,error,warn,log
LOG_RETENTION_DAYS=30
# json | pretty (default: json in production)
LOG_FORMAT=pretty

# Sent through the Firebase Trigger Email extension (SMTP is configured in the extension)
MAIL_FROM=PDAS <no-reply@pdas.am>
MAIL_REPLY_TO=support@pdas.am
MAIL_COLLECTION=mail
MAIL_TEMPLATES_COLLECTION=mailTemplates
